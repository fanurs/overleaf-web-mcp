{
  "manifest_version": 3,
  "name": "Overleaf connection helper - Fanurs",
  "version": "0.1.1",
  "description": "Transfer your Overleaf login to your private Overleaf connection test only when you click Connect.",
  "permissions": ["cookies", "scripting"],
  "host_permissions": ["https://overleaf.com/*", "https://www.overleaf.com/*", "https://overleaf-mcp.fanurs.com/*"],
  "action": { "default_title": "Connect Overleaf", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://overleaf-mcp.fanurs.com; base-uri 'none'"
  }
}
